# Copy this file to web/.env.local and replace the placeholder.
# web/.env.local is ignored by git.

NEBIUS_API_KEY=replace_with_your_nebius_token

# Optional overrides:
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Use the exact model ID and endpoint available to your Token Factory key.
# NEBIUS_REASONING_EFFORT=low  # Only if supported by your chosen model.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# GRAPH_ASSISTANT_PORT=8787

# Optional administrator review backend:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# APP_PUBLIC_URL=https://your-domain.example
# ADMIN_EMAILS=you@example.com
