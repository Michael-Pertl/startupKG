# Copy this file to web/.env.local and replace the placeholder.
# web/.env.local is ignored by git.

NEBIUS_API_KEY=replace_with_your_nebius_token

# Optional overrides:
# NEBIUS_MODEL=moonshotai/Kimi-K2.5
# NEBIUS_BASE_URL=https://api.tokenfactory.eu-west1.nebius.com/v1/
# GRAPH_ASSISTANT_PORT=8787

# Optional Ask paywall / metering MVP:
# ASK_REQUIRE_AUTH=true
# ASK_AUTH_PROVIDER=local
# ASK_ACCESS_TOKENS=demo-token-1,demo-token-2
# ASK_CREDIT_USERS={"demo-token-1":{"user_id":"demo_user","credits":25,"plan":"starter"}}
# ASK_CREDITS_PER_PROMPT=1
# ASK_MAX_REQUESTS_PER_MINUTE=8
# ASK_LEDGER_FILE=.ask_ledger.json
# ASK_USAGE_LOG_FILE=.ask_usage_log.jsonl

# Planned production auth/payments backend:
# ASK_AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# APP_PUBLIC_URL=https://your-domain.example
# ADMIN_EMAILS=you@example.com
