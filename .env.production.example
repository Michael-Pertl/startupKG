# Copy to .env on the deployment host, or configure these as host secrets.
# Do not commit real values.

NODE_ENV=production
WEB_PORT=8080
PORT=8080
APP_PUBLIC_URL=https://aimarketgraph.com

# Ask model backend. Server-side only.
NEBIUS_API_KEY=replace_with_nebius_token_factory_key
NEBIUS_MODEL=moonshotai/Kimi-K2.5
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Production Ask access. Use Supabase for public launch.
ASK_AUTH_PROVIDER=supabase
ASK_REQUIRE_AUTH=true
ASK_CREDITS_PER_PROMPT=1
ASK_MAX_REQUESTS_PER_MINUTE=8

# Supabase. Service role is server-side only; anon key is safe for the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Stripe. Use test keys until checkout/webhooks are verified end to end.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
